@{
    ViewData["Title"] = "Güncelle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}
@model SignalR.UI.Dtos.CategoryDtos.UpdateCategoryDto

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Kategori İşlemleri</h4>
        <div class="row">
            <div class="col-md-12">
                <form method="post">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title">Kategori Güncelle</div>
                        </div>
                        <div class="card-body">
                            <input type="hidden" id="categoryid" asp-for="Id" value="@Model.Id">
                            <div class="form-group">
                                <label for="categoryname">Kategori Adı</label>
                                <input type="text" class="form-control" id="categoryname" placeholder="Kategori adını girin" asp-for="Name" value="@Model.Name">
                            </div>
                        </div>
                        <div class="card-action">
                            <button class="btn btn-success">Kaydet</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>