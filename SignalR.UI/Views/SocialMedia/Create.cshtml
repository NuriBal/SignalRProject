@model SignalR.UI.Dtos.SocialMediaDtos.CreateSocialMediaDto

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Sosyal Medya İşlemleri</h4>
        <div class="row">
            <div class="col-md-12">
                <form method="post">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title">Sosyal Medya Ekle</div>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <label for="socialmediatitle">Başlık</label>
                                <input type="text" class="form-control" id="socialmediatitle" placeholder="Başlığı girin" asp-for="Title">
                            </div>
                            <div class="form-group">
                                <label for="socialmediaurl">Url</label>
                                <input type="text" class="form-control" id="socialmediaurl" placeholder="Bağlantı adresini girin" asp-for="Url">
                            </div>
                            <div class="form-group">
                                <label for="socialmediaicon">İkon</label>
                                <input type="text" class="form-control" id="socialmediaicon" placeholder="İkon sınıfını girin" asp-for="Icon">
                            </div>
                        </div>
                        <div class="card-action">
                            <button class="btn btn-success">Ekle</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
