@{
	ViewData["Title"] = "Liste";
	Layout = "~/Views/AdminLayout/Index.cshtml";
}
@model List<SignalR.UI.Dtos.ProductDtos.ResultProductDto>
<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Ürünler</h4>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">Ürün Listesi</div>
					</div>
					<div class="card-body">
						<div class="card-sub">
						</div>
						<table class="table mt-3">
							<thead>
								<tr>
									<th scope="col">#</th>
									<th scope="col">Ürün Adı</th>
									<th scope="col">Fiyat</th>
									<th scope="col">Kategori</th>
									<th scope="col">Durum</th>
									<th scope="col">Sil</th>
									<th scope="col">Güncelle</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var item in Model)
								{
									<tr>
										<td>@item.Id</td>
										<td>@item.Name</td>
										<td>@item.Price</td>
										<td>@item.CategoryName</td>
										<td>@item.Status</td>
										<td><a href="/Product/Delete/@item.Id" class="btn btn-danger">Sil</a></td>
										<td><a href="/Product/Update/@item.Id" class="btn btn-primary">Güncelle</a></td>
									</tr>
								}
							</tbody>
						</table>
						<a href="/Product/Create" class="btn btn-success">Yeni Ürün Ekle</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>