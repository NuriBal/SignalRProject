@model SignalR.UI.Dtos.AboutDtos.CreateAboutDto

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Hakkımızda İşlemleri</h4>
        <div class="row">
            <div class="col-md-12">
                <form method="post">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title">Hakkımızda Ekle</div>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <label for="abouttitle">Başlık</label>
                                <input type="text" class="form-control" id="abouttitle" placeholder="Başlığı girin" asp-for="Title">
                            </div>
                            <div class="form-group">
                                <label for="aboutdescription">Açıklama</label>
                                <input type="text" class="form-control" id="aboutdescription" placeholder="Açıklamayı girin" asp-for="Description">
                            </div>
                            <div class="form-group">
                                <label for="imageurl">Görsel</label>
                                <input type="text" class="form-control" id="imageurl" placeholder="Görsel adresini girin" asp-for="ImageUrl">
                            </div>
                        </div>
                        <div class="card-action">
                            <button class="btn btn-success">Ekle</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
