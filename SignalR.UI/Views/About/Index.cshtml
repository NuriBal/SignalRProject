@model List<SignalR.UI.Dtos.AboutDtos.ResultAboutDto>

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Hakkımızda</h4>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">Hakkımızda Listesi</div>
					</div>
					<div class="card-body">
						<div class="card-sub">
						</div>
						<table class="table mt-3">
							<thead>
								<tr>
									<th scope="col">#</th>
									<th scope="col">Başlık</th>
									<th scope="col">Açıklama</th>
									<th scope="col">Sil</th>
									<th scope="col">Güncelle</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var item in Model)
								{
									<tr>
										<td>@item.Id</td>
										<td>@item.Title</td>
										<td>@item.Description</td>
										<td><a href="/About/Delete/@item.Id" class="btn btn-danger">Sil</a></td>
										<td><a href="/About/Update/@item.Id" class="btn btn-primary">Güncelle</a></td>
									</tr>
								}
							</tbody>
						</table>
						<a href="/About/Create" class="btn btn-success">Yeni Hakkımızda Bilgisi Ekle</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
