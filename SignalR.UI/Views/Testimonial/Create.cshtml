@model SignalR.UI.Dtos.TestimonialDtos.CreateTestimonialDto

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Referans İşlemleri</h4>
        <div class="row">
            <div class="col-md-12">
                <form method="post">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title">Referans Ekle</div>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <label for="testimonialname">Ad Soyad</label>
                                <input type="text" class="form-control" id="testimonialname" placeholder="Ad soyad girin" asp-for="Name">
                            </div>
                            <div class="form-group">
                                <label for="testimonialtitle">Ünvan</label>
                                <input type="text" class="form-control" id="testimonialtitle" placeholder="Ünvanı girin" asp-for="Title">
                            </div>
                            <div class="form-group">
                                <label for="testimonialcomment">Yorum</label>
                                <input type="text" class="form-control" id="testimonialcomment" placeholder="Yorumu girin" asp-for="Comment">
                            </div>
                            <div class="form-group">
                                <label for="imageurl">Görsel</label>
                                <input type="text" class="form-control" id="imageurl" placeholder="Görsel adresini girin" asp-for="ImageUrl">
                            </div>
                        </div>
                        <div class="card-action">
                            <button class="btn btn-success">Ekle</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
