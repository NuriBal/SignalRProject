@model SignalR.UI.Dtos.ContactDtos.UpdateContactDto

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">İletişim İşlemleri</h4>
        <div class="row">
            <div class="col-md-12">
                <form method="post">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title">İletişim Bilgisi Güncelle</div>
                        </div>
                        <div class="card-body">
                            <input type="hidden" id="contactid" asp-for="Id">
                            <div class="form-group">
                                <label for="contactlocation">Konum</label>
                                <input type="text" class="form-control" id="contactlocation" placeholder="Konumu girin" asp-for="Location">
                            </div>
                            <div class="form-group">
                                <label for="contactphone">Telefon</label>
                                <input type="tel" class="form-control" id="contactphone" placeholder="Telefon numarasını girin" asp-for="Phone">
                            </div>
                            <div class="form-group">
                                <label for="contactmail">Mail</label>
                                <input type="email" class="form-control" id="contactmail" placeholder="Mail adresini girin" asp-for="Mail">
                            </div>
                            <div class="form-group">
                                <label for="contactfooterdescription">Footer Açıklaması</label>
                                <input type="text" class="form-control" id="contactfooterdescription" placeholder="Footer açıklamasını girin" asp-for="FooterDescription">
                            </div>
                        </div>
                        <div class="card-action">
                            <button class="btn btn-success">Kaydet</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
