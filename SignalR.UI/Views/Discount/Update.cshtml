@model SignalR.UI.Dtos.DiscountDtos.UpdateDiscountDto

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">İndirim İşlemleri</h4>
        <div class="row">
            <div class="col-md-12">
                <form method="post">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title">İndirim Güncelle</div>
                        </div>
                        <div class="card-body">
                            <input type="hidden" id="discountid" asp-for="Id">
                            <div class="form-group">
                                <label for="discounttitle">Başlık</label>
                                <input type="text" class="form-control" id="discounttitle" placeholder="Başlığı girin" asp-for="Title">
                            </div>
                            <div class="form-group">
                                <label for="discountdescription">Açıklama</label>
                                <input type="text" class="form-control" id="discountdescription" placeholder="Açıklamayı girin" asp-for="Description">
                            </div>
                            <div class="form-group">
                                <label for="discountamount">İndirim Miktarı</label>
                                <input type="text" class="form-control" id="discountamount" placeholder="İndirim miktarını girin" asp-for="Amount">
                            </div>
                            <div class="form-group">
                                <label for="imageurl">Görsel</label>
                                <input type="text" class="form-control" id="imageurl" placeholder="Görsel adresini girin" asp-for="ImageUrl">
                            </div>
                        </div>
                        <div class="card-action">
                            <button class="btn btn-success">Kaydet</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
