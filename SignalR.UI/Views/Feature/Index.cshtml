@model List<SignalR.UI.Dtos.FeatureDtos.ResultFeatureDto>

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Öne Çıkanlar</h4>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">Öne Çıkanlar Listesi</div>
					</div>
					<div class="card-body">
						<div class="card-sub">
						</div>
						<table class="table mt-3">
							<thead>
								<tr>
									<th scope="col">#</th>
									<th scope="col">Başlık 1</th>
									<th scope="col">Başlık 2</th>
									<th scope="col">Başlık 3</th>
									<th scope="col">Sil</th>
									<th scope="col">Güncelle</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var item in Model)
								{
									<tr>
										<td>@item.Id</td>
										<td>@item.TitleOne</td>
										<td>@item.TitleTwo</td>
										<td>@item.TitleTree</td>
										<td><a href="/Feature/Delete/@item.Id" class="btn btn-danger">Sil</a></td>
										<td><a href="/Feature/Update/@item.Id" class="btn btn-primary">Güncelle</a></td>
									</tr>
								}
							</tbody>
						</table>
						<a href="/Feature/Create" class="btn btn-success">Yeni Öne Çıkan Ekle</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
